@import url('https://fonts.googleapis.com/css1?family=JetBrains+Mono:wght@400;600&display=swap');

* {
    box-sizing: border-box;
}

body {
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    background: #0d1117;
    color: #cdd9e5;
    font-family: 'JetBrains Mono', 'Fira Code', 'Cascadia Code', monospace;
    font-size: 15px;
    line-height: 1.8;
}

h1 {
    color: #79c0ff;
    font-size: 1.6rem;
    font-weight: 600;
    letter-spacing: -0.5px;
    margin: 0 0 0.5rem;
}

h2 {
    color: #3fb950;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 2rem 0 1rem;
}

h3 {
    color: #79c0ff;
    font-size: 1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.5rem;
}

h4, h5, h6 {
    color: #cdd9e5;
    font-weight: 600;
    margin: 1.2rem 0 0.4rem;
}

a {
    color: #79c0ff;
    text-decoration: none;
}

a:hover {
    text-decoration: underline;
    color: #a5d6ff;
}

p {
    margin: 0 0 1rem;
    color: #cdd9e5;
}

hr {
    border: none;
    border-top: 1px solid #21262d;
    margin: 1.5rem 0;
}

ul, ol {
    padding-left: 0;
    margin: 0 0 1rem;
    list-style: none;
}

ul li::before {
    content: '→';
    color: #3fb950;
    margin-right: 0.6rem;
}

ol {
    counter-reset: list;
}

ol li {
    counter-increment: list;
}

ol li::before {
    content: counter(list) '.';
    color: #3fb950;
    margin-right: 0.6rem;
}

li {
    margin-bottom: 0.4rem;
}

code {
    background: #161b22;
    border: 1px solid #21262d;
    color: #e6edf3;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.88em;
    font-family: inherit;
}

pre {
    background: #161b22;
    border: 1px solid #21262d;
    border-radius: 6px;
    padding: 1.2rem;
    overflow-x: auto;
    margin: 1rem 0;
    font-size: 0.88em;
    line-height: 1.6;
}

pre code {
    background: none;
    border: none;
    padding: 0;
    color: #e6edf3;
}

blockquote {
    border-left: 3px solid #3fb950;
    margin: 1.2rem 0;
    padding: 0.4rem 0 0.4rem 1rem;
    color: #8b949e;
    font-style: italic;
}

blockquote p {
    color: #8b949e;
    margin: 0;
}

table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.9em;
}

th {
    text-align: left;
    color: #3fb950;
    border-bottom: 1px solid #21262d;
    padding: 0.5rem 0.8rem 0.5rem 0;
    font-weight: 600;
}

td {
    padding: 0.4rem 0.8rem 0.4rem 0;
    border-bottom: 1px solid #161b22;
    color: #cdd9e5;
    vertical-align: top;
}

tr:last-child td {
    border-bottom: none;
}

em {
    color: #8b949e;
    font-style: italic;
}

strong {
    color: #e6edf3;
    font-weight: 600;
}

.header a {
    color: inherit;
    text-decoration: none;
}

@media (max-width: 600px) {
    body {
        padding: 1.2rem;
        font-size: 18px;
        line-height: 1.9;
    }

    h1 {
        font-size: 1.8rem;
        line-height: 1.3;
        margin-bottom: 1rem;
    }

    h2 {
        font-size: 1.05rem;
        margin-top: 2.2rem;
    }

    h3 {
        font-size: 1rem;
    }

    p,
    li {
        font-size: 1rem;
    }

    pre {
        padding: 1rem;
        font-size: 0.95rem;
        line-height: 1.7;
        overflow-x: auto;
    }

    code {
        font-size: 0.92em;
    }

    table {
        display: block;
        overflow-x: auto;
        white-space: nowrap;
    }
}
